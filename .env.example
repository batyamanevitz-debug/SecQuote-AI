# Gemini — optional, used for ONE call when the quote is produced.
# Leave empty to compose the summary locally with no model call.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase ---
# Project URL + publishable (anon) key. Both are safe in the browser;
# Row Level Security enforces per-user data isolation.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
